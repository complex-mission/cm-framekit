# CM FrameKit 官网 / 发布服务器 — 配置样例
# 复制为 .env 后填写：cp .env.example .env
# 没写的项走代码默认值（见 config.go）。真实环境变量优先于 .env。

# ---- HTTP ----
ADDR=:8080
BASE_URL=https://fk.complexmission.com
DATA_DIR=./data
# 在 nginx / Caddy 后面并启用 HTTPS 时保持 true
SECURE_COOKIES=true
TRUST_PROXY=true

# ---- 后台（短信验证码登录；只有这个手机号能登录并上传安装包） ----
ADMIN_PHONE=13800138000
# 后台入口路径，建议换成不易猜的字符串，例如 /fk-admin-7c2e
ADMIN_PATH=/admin
SESSION_TTL=24h
OTP_TTL=5m

# ---- 阿里云短信（模板里必须包含 ${code}） ----
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 仅本地调试：验证码打印到日志而不发短信。生产环境不要开
SMS_DEV=false

# ---- 阿里云验证码 2.0（官网下载前的人机验证） ----
# 控制台 → 验证码 2.0 → 场景管理 新建场景（建议「一点即过」或「滑块」，弹出式）
# PREFIX 在控制台「概览」页右上角的「身份标」
CAPTCHA_PREFIX=
CAPTCHA_SCENE_ID=
CAPTCHA_REGION=cn
CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
# 不填则沿用上面短信的 AccessKey（该 RAM 用户需有 AliyunYundunAFSFullAccess 或验证码校验权限）
CAPTCHA_ACCESS_KEY_ID=
CAPTCHA_ACCESS_KEY_SECRET=
# 仅本地调试：跳过人机验证。生产环境不要开
CAPTCHA_DISABLED=false
# 加密模式（防止场景 ID 被盗用）：本地 false，线上 true。
# 上线顺序：先在 .env 设 true 并填 ekey，重启服务、确认下载正常，再到控制台「场景管理」打开该场景的加密模式开关。
# 反过来（控制台先开、这里没开）会导致所有下载验证失败。
CAPTCHA_ENCRYPT=false
# 控制台「概览」页右上角的密钥（ekey），Base64 字符串，解码后必须是 32 字节
CAPTCHA_EKEY=
# 加密场景 ID 的有效期（1m ~ 24h）；页面停留超过这个时间，点击下载时会自动重新获取
CAPTCHA_ENCRYPT_TTL=1h

# ---- 阿里云 OSS（私有 bucket，下载走临时签名链接） ----
# 不配 OSS 时安装包存在 DATA_DIR/files（仅用于本地调试）
OSS_REGION=cn-hangzhou
# 留空按 region 自动推导；同地域 ECS 可用内网 oss-cn-hangzhou-internal.aliyuncs.com 上传，
# 但内网 endpoint 签出的下载链接外网打不开，所以一般留空或填公网 endpoint
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 对象 key 前缀：{OSS_PREFIX}releases/{version}/{platform}/{file}
OSS_PREFIX=cm-framekit/
# 签名下载链接有效期
DOWNLOAD_URL_TTL=15m
# 单个安装包上传上限（MB）
MAX_UPLOAD_MB=1024

# ---- Redis（可选）----
# 用于会话、短信验证码和限流计数；留空则存在进程内存里（重启后需重新登录，单实例够用）。
# 拼接方式：
#   redis://[用户名]:[密码]@[主机]:[端口]/[库号]
#   阿里云 Redis 账号模式：redis://账号:密码@r-xxxx.redis.rds.aliyuncs.com:6379/0
#   只有密码（默认账号）：  redis://:密码@r-xxxx.redis.rds.aliyuncs.com:6379/0
#   无密码本机：           redis://127.0.0.1:6379/0
#   TLS：                  rediss://账号:密码@主机:6380/0
# 密码里有 @ : / # ? % 等字符时要做 URL 编码（例如 @ 写成 %40）。
# 所有 key 带 fk: 前缀，可与其它服务共用一个库。
REDIS_URL=

# ---- 限流（按客户端 IP） ----
RATE_DOWNLOADS_PER_HOUR=30
RATE_OTP_PER_10MIN=3
RATE_LOGIN_PER_10MIN=10
RATE_UPDATE_PER_MIN=30
RATE_CAPTCHA_SCENE_PER_MIN=30

# ---- CM 推送中心（敏感操作通知 + 官网留言） ----
# 登录 / 验证码 / 上传 / 发布 / 下线 / 删除 / 服务启动 / 留言 都会推送；下载不推送。
# 留空则不推送。App Key 是真实凭据，只写在 .env，不要提交。
CM_PUSH_APP_KEY=
CM_PUSH_URL=https://cm-notification.complexmission.com/push
# 官网留言：每个 IP 每天上限（另有每 IP 每分钟 1 条、全站每天 200 条）
RATE_CONTACT_PER_DAY=5

# ---- 其它 ----
GITHUB_REPO=complex-mission/cm-framekit
